// Hekpixle resource script template (CMake @-substitutes the version + icon path).
#include <windows.h>

1 ICON "icon.ico"

// (the manifest is added by CMake from res/Hekpixle.manifest; embedding it here too would be a duplicate)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,13,0,0
 PRODUCTVERSION 0,13,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Hekpixle"
      VALUE "FileDescription", "Hekpixle - personal AI agent"
      VALUE "FileVersion", "0.13.0"
      VALUE "InternalName", "Hekpixle"
      VALUE "OriginalFilename", "Hekpixle.exe"
      VALUE "ProductName", "Hekpixle"
      VALUE "ProductVersion", "0.13.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
